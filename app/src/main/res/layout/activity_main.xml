<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_horizontal"
        android:paddingBottom="@dimen/padding_bottom">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="@string/app_name_lowercase"
            android:textColor="@color/white"
            android:textSize="@dimen/text_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_button_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_menu_layout_height"
            android:layout_marginVertical="@dimen/main_menu_layout_marginVertical"
            android:layout_weight="@integer/main_menu_layout_weight"
            android:backgroundTint="@color/white"
            android:letterSpacing="@integer/main_menu_letter_spacing"
            android:text="@string/search"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="@dimen/text_large"
            app:cornerRadius="@dimen/main_menu_cornerRadius"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/main_menu_iconPadding"
            app:iconTint="@color/black"
            app:rippleColor="@color/gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_button_media_library"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_menu_layout_height"
            android:layout_marginVertical="@dimen/main_menu_layout_marginVertical"
            android:layout_weight="@integer/main_menu_layout_weight"
            android:backgroundTint="@color/white"
            android:letterSpacing="@integer/main_menu_letter_spacing"
            android:text="@string/media_library"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="@dimen/text_large"
            app:cornerRadius="@dimen/main_menu_cornerRadius"
            app:icon="@drawable/ic_media_library"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/main_menu_iconPadding"
            app:iconTint="@color/black"
            app:rippleColor="@color/gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_button_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_menu_layout_height"
            android:layout_marginVertical="@dimen/main_menu_layout_marginVertical"
            android:layout_weight="@integer/main_menu_layout_weight"
            android:backgroundTint="@color/white"
            android:letterSpacing="@integer/main_menu_letter_spacing"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="@dimen/text_large"
            app:cornerRadius="@dimen/main_menu_cornerRadius"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/main_menu_iconPadding"
            app:iconTint="@color/black"
            app:rippleColor="@color/gray" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

